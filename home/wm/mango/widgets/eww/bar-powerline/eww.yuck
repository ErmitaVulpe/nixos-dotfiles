
(defwindow bar-powerline
  :monitor 0
  :stacking "fg"
  :exclusive true
  :geometry (geometry :width "100%" :height "3%"
                      :anchor "top center")
  (bar-powerline_layout))

(defwidget _battery [battery status]
  (box :class "bat-box" :space-evenly false :spacing 8
    (label :text {status == 'Charging' ?
      battery < 5 ? "󰢟":
        battery < 10 ? "󰢜":
          battery < 20 ? "󰂆" :
            battery < 30 ? "󰂇" :
              battery < 40 ? "󰂈" :
                battery < 50 ? "󰢝" :
                  battery < 60 ? "󰂉" :
                    battery < 70 ? "󰢞" :
                      battery < 80 ? "󰂊" :
                        battery < 90 ? "󰂋" : "󰂅" :
      battery < 5 ? "󱃍" :
        battery < 10 ? "󰁺" :
          battery < 20 ? "󰁻" :
            battery < 30 ? "󰁼" :
              battery < 40 ? "󰁽" :
                battery < 50 ? "󰁾" :
                  battery < 60 ? "󰁿" :
                    battery < 70 ? "󰂀" :
                      battery < 80 ? "󰂁" :
                        battery < 90 ? "󰂂" : "󰁹"})
    (label :text "${battery}%")))

(defwidget bar-powerline_layout []
  (box :space-evenly false :hexpand true :vexpand true
    (box :class "bar-powerline_left" :spacing 15 :space-evenly false
         :halign "start"
      (label :text "asdnajsd jas jlhsdav" :class "sep"))
    (box :class "bar-powerline_right" :spacing 5 :vexpand true :hexpand true
         :halign "end" :space-evenly false
      (systray)
      (_battery :status {EWW_BATTERY.BAT0.status}
                :battery {EWW_BATTERY.BAT0.capacity})
      (label :text {formattime(EWW_TIME, "%H:%M %b %d, %Y")} :class "time"))
      (box)))
